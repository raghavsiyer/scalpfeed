<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- The same feed core the plugin ships, tested without Quantower. -->
    <Compile Include="..\ScalpFeedVendor\Feed\*.cs" LinkBase="Feed" />
    <!-- The indicators' Quantower-free maths. -->
    <Compile Include="..\ScalpFeedIndicators\SessionVwap.cs" LinkBase="Indicators" />
    <Compile Include="..\ScalpFeedIndicators\MacdV.cs" LinkBase="Indicators" />
  </ItemGroup>
</Project>
