<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Quantower v1.147.11 runs on .NET 10 with the Windows Desktop runtime (Starter.runtimeconfig.json), which is
         where the System.Drawing.Graphics a chart paints with comes from; the rolling candle draws with it. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AssemblyName>KeyMovingAverages</AssemblyName>
    <QuantowerBin Condition="'$(QuantowerBin)' == ''">C:\Quantower\TradingPlatform\v1.147.11\bin</QuantowerBin>
  </PropertyGroup>

  <ItemGroup>
    <!-- The float, split and offering files' formats, RVOL's arithmetic and the way to volume at price, shared with the
         connection. -->
    <Compile Include="..\ScalpFeedVendor\Feed\FloatFacts.cs" LinkBase="Shared" />
    <Compile Include="..\ScalpFeedVendor\Feed\ReverseSplits.cs" LinkBase="Shared" />
    <Compile Include="..\ScalpFeedVendor\Feed\Offerings.cs" LinkBase="Shared" />
    <Compile Include="..\ScalpFeedVendor\Feed\CacheFile.cs" LinkBase="Shared" />
    <Compile Include="..\ScalpFeedVendor\Feed\VolumeAtPriceShare.cs" LinkBase="Shared" />
    <Compile Include="..\ScalpFeedVendor\Feed\RelativeVolumeMath.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <!-- The rolling candle lives in its own repo, the rolling-candle submodule (clone with its submodules), and is
         built in here too: Key Moving Averages draws it, and the Rolling Candle indicator ships in this DLL. -->
    <Compile Include="..\rolling-candle\src\RollingCandle.cs" LinkBase="RollingCandle" />
    <Compile Include="..\rolling-candle\src\RollingCandleView.cs" LinkBase="RollingCandle" />
    <Compile Include="..\rolling-candle\src\RollingCandleIndicator.cs" LinkBase="RollingCandle" />
    <Compile Include="..\rolling-candle\src\CandleShade.cs" LinkBase="RollingCandle" />
    <Compile Include="..\rolling-candle\src\TapeBursts.cs" LinkBase="RollingCandle" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile against the installed DLL; Quantower supplies it at runtime, so never copy it. -->
    <Reference Include="TradingPlatform.BusinessLayer">
      <HintPath>$(QuantowerBin)\TradingPlatform.BusinessLayer.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
